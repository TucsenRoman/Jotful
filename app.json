{
  "expo": {
    "name": "Unsorted",
    "slug": "unsorted",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tucsenroman.unsorted",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tucsenroman.unsorted"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-audio",
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "4a223528-463e-4cd0-a5b8-3871cceae8e1"
      }
    }
  }
}
