{
  "expo": {
    "name": "Jotful",
    "slug": "unsorted",
    "scheme": "jotful",
    "version": "1.0.0",
    "icon": "./assets/icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tucsenroman.unsorted",
      "appleTeamId": "AVVSMR4ABB",
      "buildNumber": "6",
      "icon": {
        "light": "./assets/ios-icons/jotful-light.png",
        "dark": "./assets/ios-icons/jotful-dark.png",
        "tinted": "./assets/ios-icons/jotful-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tucsenroman.unsorted"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Jotful to use the microphone for private on-device voice input.",
          "speechRecognitionPermission": "Allow Jotful to recognize your speech on-device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Jotful to add photos and videos to your private thought inbox.",
          "cameraPermission": "Allow Jotful to capture photos and videos for your private thought inbox."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Jotful to capture photos and videos for your private thought inbox.",
          "microphonePermission": "Allow Jotful to record sound with your videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Jotful to show photos and videos from your library in its private media picker."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Jotful to record private audio notes."
        }
      ],
      "@apollohg/react-native-rich-text-editor",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "UnsortedCapture",
              "displayName": "Jotful",
              "description": "A private place to capture a thought.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            },
            {
              "name": "UnsortedRecents",
              "displayName": "Jotful Jots",
              "description": "Your latest captured thoughts.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      "expo-font",
      "expo-video",
      "@react-native-vector-icons/material-design-icons",
      "@bacons/apple-targets",
      [
        "@appsent-co/react-native-watchos",
        {
          "targetName": "watch"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4a223528-463e-4cd0-a5b8-3871cceae8e1"
      }
    }
  }
}
